# Copia este archivo a ".env" (nunca subas el .env real a git) y completa
# con tus credenciales de Brevo (https://app.brevo.com → Settings → API Keys).
# Usa una API key restringida SOLO a "Transactional emails", no la maestra.

EXPO_PUBLIC_BREVO_API_KEY=
EXPO_PUBLIC_BREVO_SENDER_EMAIL=
EXPO_PUBLIC_BREVO_SENDER_NAME=InduMap
